# Payload CMS configuration for original YouMind scripts
CMS_HOST=https://your-cms-host.com
CMS_API_KEY=your-api-key-here

# Evolink / Gemini cleaner
EVOLINK_API_KEY=
EVOLINK_API_URL=https://api.evolink.ai/v1beta/models/gemini-2.5-flash-lite:generateContent

# Obsidian collection vault
OBSIDIAN_VAULT_DIR=/Users/chdj/project/site-projects/img2ai-research-vault
OBSIDIAN_INBOX_DIR=00-inbox
# Optional: move raw notes here after an issue is created.
# Leave empty if you want the cleaner to never move Obsidian files.
OBSIDIAN_PROCESSED_DIR=10-raw/submitted
CLEAN_LIMIT=5
CLEANED_OUTPUT_DIR=data/my/cleaned

# GitHub issue automation
GITHUB_TOKEN=
GITHUB_REPOSITORY=CH0918/awesome-gpt-image-2

# README generation
# Keep this empty if you only want your local prompts in README.md.
# Set it to YouMind's raw README if you want to append your own prompts after upstream content.
UPSTREAM_README_URL=https://raw.githubusercontent.com/YouMind-OpenLab/awesome-gpt-image-2/main/README.md
LOCAL_README_OUTPUT=README.md
APPROVED_OUTPUT_DIR=data/my/approved
